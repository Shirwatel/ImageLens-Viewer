{
  "manifest_version": 3,
  "name": "ImageLens Viewer",
  "short_name": "ImageLens",
  "version": "1.1.0",
  "description": "A faster, cleaner way to view images in Chrome: zoom, pan, rotate, flip, and save any image, with a distraction-free full-screen overlay for image sites.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "options_page": "options/options.html",
  "permissions": ["storage", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/content.css"],
      "js": ["content/content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "incognito": "split"
}
